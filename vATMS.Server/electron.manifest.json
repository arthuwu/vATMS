{
  "executable": "vATMS.Server",
  "splashscreen": {
    "imageFile": ""
  },
  "name": "vATMS",
  "author": "",
  "singleInstance": false,
  "environment": "Production",
  "build": {
    "appId": "com.vATMS.app",
    "productName": "vATMS",
    "copyright": "Copyright © 2025",
    "buildVersion": "1.0.0",
    "compression": "maximum",
    "directories": {
      "output": "../../../bin/Desktop"
    },
    "extraResources": [
      {
        "from": "./bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      {
        "from": "./ElectronHostHook/node_modules",
        "to": "ElectronHostHook/node_modules",
        "filter": [
          "**/*"
        ]
      },
      "**/*"
    ],
    "win": {
      "icon": "/wwwroot/icon/vATMS.ico"
    }
  }
}